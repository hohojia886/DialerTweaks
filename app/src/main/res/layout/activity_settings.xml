<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Dialer Mods -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/dialer_mods"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorPrimary" />

                    <!-- Section 1: Standard Call Recording (Linked) -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_call_recording"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:thumbIcon="@drawable/ic_switch_check"
                        android:text="@string/enable_call_recording" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/call_rec_warning"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorError" />

                    <LinearLayout
                        android:id="@+id/layout_call_recording_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="0dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_disable_announcement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:thumbIcon="@drawable/ic_switch_check"
                            android:text="@string/disable_voice_announcement" />

                    </LinearLayout>

                    <!-- Divider separating Call Recording group from Call Notes -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Section 2: Call Notes (Independent) -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_disable_call_notes_announcement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:thumbIcon="@drawable/ic_switch_check"
                        android:text="@string/disable_call_notes_announcement" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Debug Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_debug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/debug_logs_title"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorPrimary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_master_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:thumbIcon="@drawable/ic_switch_check"
                        android:text="@string/enable_master_log" />

                    <LinearLayout
                        android:id="@+id/layout_debug_sub_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_log_call_recording"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:thumbIcon="@drawable/ic_switch_check"
                            android:text="@string/log_call_rec" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/text_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="v1.0.0" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
