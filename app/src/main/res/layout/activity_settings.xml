<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="@string/app_name" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Google Dialer Group -->
            <LinearLayout
                android:id="@+id/layout_call_recording_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/title_dialer_mods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/dialer_mods"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorSecondary" />

                <!-- Top -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_call_recording"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="2dp"
                    app:contentPadding="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardPreventCornerOverlap="false"
                    style="@style/Widget.Material3.CardView.Filled"
                    app:cardBackgroundColor="?attr/settingsCardBackground"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Settings.Card.Top">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_call_recording"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/enable_call_recording"
                        app:thumbIcon="@drawable/ic_switch_check" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Middle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_disable_announcement"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone"
                    app:contentPadding="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardPreventCornerOverlap="false"
                    style="@style/Widget.Material3.CardView.Filled"
                    app:cardBackgroundColor="?attr/settingsCardBackground"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Settings.Card.Middle">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_disable_announcement"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/disable_voice_announcement"
                        app:thumbIcon="@drawable/ic_switch_check" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Bottom -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_disable_call_notes"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:contentPadding="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardPreventCornerOverlap="false"
                    style="@style/Widget.Material3.CardView.Filled"
                    app:cardBackgroundColor="?attr/settingsCardBackground"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Settings.Card.Bottom">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_disable_call_notes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/disable_call_notes_announcement"
                        app:thumbIcon="@drawable/ic_switch_check" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Debug & Logs Group -->
            <LinearLayout
                android:id="@+id/group_debug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/debug_logs_title"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorSecondary" />

                <!-- Top -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_master_log"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="2dp"
                    app:contentPadding="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardPreventCornerOverlap="false"
                    style="@style/Widget.Material3.CardView.Filled"
                    app:cardBackgroundColor="?attr/settingsCardBackground"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Settings.Card.Top">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_master_log"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/enable_master_log"
                        app:thumbIcon="@drawable/ic_switch_check" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Sub Logs (Middle & Bottom) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_log_call_recording"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone"
                    app:contentPadding="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardPreventCornerOverlap="false"
                    style="@style/Widget.Material3.CardView.Filled"
                    app:cardBackgroundColor="?attr/settingsCardBackground"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Settings.Card.Middle">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_log_call_recording"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/log_call_rec"
                        app:thumbIcon="@drawable/ic_switch_check" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_log_call_notes"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:visibility="gone"
                    app:contentPadding="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardPreventCornerOverlap="false"
                    style="@style/Widget.Material3.CardView.Filled"
                    app:cardBackgroundColor="?attr/settingsCardBackground"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Settings.Card.Bottom">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_log_call_notes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/log_call_notes"
                        app:thumbIcon="@drawable/ic_switch_check" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/text_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="v1.0.0" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
